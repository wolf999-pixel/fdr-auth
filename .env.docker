# Docker Environment Configuration for FDR Auth System

# Detectez votre IP locale: ipconfig (Windows) ou ifconfig (Linux/Mac)
# Remplacez 172.23.27.88 par votre adresse IPv4
DOCKER_HOST_IP=172.23.27.88

# Backend Configuration
BACKEND_PORT=4000
PUBLIC_APP_URL=http://${DOCKER_HOST_IP}:5173

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://${DOCKER_HOST_IP}:4000/api

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fdr_auth
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fdr_auth

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node Environment
NODE_ENV=production
