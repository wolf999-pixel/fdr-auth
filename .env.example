# ===================================================
# CONFIGURATION PRODUCTION - FONDS ROUTIER QR-AUTH
# ===================================================

# URL publique où le site est accessible (très important pour les QR codes !)
# Exemple : https://auth.fondsroutier.cm ou https://fdr-auth.onrender.com
PUBLIC_APP_URL=http://localhost

# Clé secrète JWT pour la signature des sessions
JWT_SECRET=generer-une-cle-secrete-aleatoire-tres-longue-ici

# Base de données PostgreSQL
POSTGRES_DB=fdr_qrauth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Andre1234
